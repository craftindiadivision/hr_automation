 "html": "<style>\n\n    /* =========================================================\n       PREMIUM TRAINING CERTIFICATE\n       A4 LANDSCAPE\n       ========================================================= */\n\n    @page {\n        size: A4 landscape;\n        margin: 0;\n    }\n\n    @media print {\n\n        html,\n        body {\n            width: 297mm;\n            height: 210mm;\n            margin: 0 !important;\n            padding: 0 !important;\n        }\n\n        .certificate-page {\n            page-break-after: avoid;\n            page-break-inside: avoid;\n        }\n    }\n\n    * {\n        box-sizing: border-box;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        background: #ffffff;\n        color: #000000;\n        font-family: Georgia, \"Times New Roman\", serif;\n    }\n\n    .certificate-page {\n        width: 297mm;\n        height: 210mm;\n        position: relative;\n        background: #ffffff;\n        overflow: hidden;\n        color: #000000;\n    }\n\n    .outer-border {\n        position: absolute;\n        top: 5mm;\n        left: 5mm;\n        right: 5mm;\n        bottom: 5mm;\n        border: 2px solid #000000;\n        pointer-events: none;\n    }\n\n    .inner-border {\n        position: absolute;\n        top: 11mm;\n        left: 11mm;\n        right: 11mm;\n        bottom: 11mm;\n        border: 1px solid #000000;\n        pointer-events: none;\n    }\n\n    .certificate-content {\n        position: absolute;\n        top: 20mm;\n        left: 25mm;\n        right: 25mm;\n        bottom: 18mm;\n        text-align: center;\n    }\n\n    .logo-wrapper {\n        width: 100%;\n        text-align: center;\n        margin-bottom: 4mm;\n    }\n\n    .company-logo {\n        height: 68px;\n        width: auto;\n        max-width: 80mm;\n        object-fit: contain;\n        display: inline-block;\n    }\n\n    .certificate-label {\n        margin-top: 2mm;\n        font-family: Georgia, \"Times New Roman\", serif;\n        font-size: 13px;\n        font-weight: normal;\n        letter-spacing: 5px;\n        text-transform: uppercase;\n        color: #000000;\n    }\n\n    .certificate-title {\n        margin-top: 2mm;\n        font-family: Georgia, \"Times New Roman\", serif;\n        font-size: 39px;\n        line-height: 1.1;\n        font-weight: bold;\n        letter-spacing: 2px;\n        text-transform: uppercase;\n        color: #000000;\n    }\n\n    .title-divider {\n        width: 45mm;\n        margin: 4mm auto 0 auto;\n        border-top: 1px solid #000000;\n        position: relative;\n    }\n\n    .title-divider::after {\n        content: \"\";\n        position: absolute;\n        width: 6px;\n        height: 6px;\n        border: 1px solid #000000;\n        background: #ffffff;\n        transform: rotate(45deg);\n        left: 50%;\n        top: -4px;\n        margin-left: -3px;\n    }\n\n    .presented-text {\n        margin-top: 7mm;\n        font-size: 14px;\n        font-style: italic;\n        color: #000000;\n    }\n\n    .employee-name {\n        display: inline-block;\n        margin-top: 3mm;\n        padding: 0 15mm 3mm 15mm;\n        font-family: Georgia, \"Times New Roman\", serif;\n        font-size: 32px;\n        line-height: 1.2;\n        font-weight: bold;\n        letter-spacing: 0.5px;\n        color: #000000;\n        border-bottom: 1px solid #000000;\n    }\n\n    .achievement-intro {\n        margin-top: 6mm;\n        font-size: 14px;\n        line-height: 1.5;\n        color: #000000;\n    }\n\n    .training-program {\n        display: inline-block;\n        margin-top: 3mm;\n        padding: 2.5mm 12mm;\n        border-top: 1px solid #000000;\n        border-bottom: 1px solid #000000;\n        font-size: 19px;\n        font-weight: bold;\n        letter-spacing: 1px;\n        text-transform: uppercase;\n        color: #000000;\n    }\n\n    .description {\n        max-width: 195mm;\n        margin: 4mm auto 0 auto;\n        font-size: 14px;\n        line-height: 1.55;\n        color: #000000;\n    }\n\n    .description strong {\n        font-weight: bold;\n        color: #000000;\n    }\n\n    .completion-date {\n        margin-top: 5mm;\n        font-size: 13px;\n        font-style: italic;\n        color: #000000;\n    }\n\n    .completion-date strong {\n        font-style: normal;\n        font-weight: bold;\n        color: #000000;\n    }\n\n    .signature-section {\n        position: absolute;\n        left: 18mm;\n        right: 18mm;\n        bottom: 0;\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-end;\n    }\n\n    .signature {\n        width: 55mm;\n        text-align: center;\n    }\n\n    .signature-image {\n        height: 14mm;\n        max-width: 100%;\n        object-fit: contain;\n        margin-bottom: 1mm;\n    }\n\n    .signature-line {\n        width: 100%;\n        height: 1px;\n        background: #000000;\n        margin-bottom: 2mm;\n    }\n\n    .signature-name {\n        font-size: 12px;\n        font-weight: bold;\n        color: #000000;\n    }\n\n    .no-break {\n        page-break-inside: avoid;\n        break-inside: avoid;\n    }\n\n</style>\n\n\n<div class=\"certificate-page\">\n\n    <div class=\"outer-border\"></div>\n    <div class=\"inner-border\"></div>\n\n    <div class=\"certificate-content no-break\">\n\n        <div class=\"logo-wrapper\">\n            <img\n                src=\"/files/craft_logo (1).png\"\n                class=\"company-logo\"\n            >\n        </div>\n\n        <div class=\"certificate-title\">\n            Certificate of Completion\n        </div>\n\n        <div class=\"title-divider\"></div>\n\n        <div class=\"presented-text\">\n            This certificate is proudly presented to\n        </div>\n\n        <div class=\"employee-name\">\n            {{ doc.employee_name }}\n        </div>\n\n        <div class=\"achievement-intro\">\n            For successfully completing the\n        </div>\n\n        <div class=\"training-program\">\n            {{ doc.training_program }}\n        </div>\n\n        <div class=\"description\">\n            {% set total_modules = frappe.db.get_value(\"Training Program\", doc.training_program, \"custom_number_of_events\") %}\n            consisting of\n            <strong>{{ total_modules or 0 }}</strong>\n            training modules, demonstrating dedication,\n            leadership growth, and professional competence.\n        </div>\n\n        <div class=\"completion-date\">\n            Completed on\n            <strong>\n                {% if doc.completed_on %}\n                    {{ frappe.utils.formatdate(doc.completed_on, \"dd MMMM, yyyy\") }}\n                {% endif %}\n            </strong>\n        </div>\n\n        <div class=\"signature-section\">\n\n            <div class=\"signature\">\n                {% set trainer_name = frappe.db.get_value(\"Training Program\", doc.training_program, \"trainer_name\") %}\n                {% set sig = frappe.db.get_value(\"Training Program\", doc.training_program, \"custom_trainer_signature\") %}\n                {% if sig %}<img src=\"{{ sig }}\" class=\"signature-image\">{% endif %}\n                <div class=\"signature-line\"></div>\n                <div class=\"signature-name\">\n                    {{ trainer_name or \"Training Manager\" }}\n                </div>\n            </div>\n\n            <div class=\"signature\">\n                {% set director_name = frappe.db.get_single_value(\"HR Automation Settings\", \"director_name\") %}\n                {% set director_sig = frappe.db.get_single_value(\"HR Automation Settings\", \"director_signature\") %}\n                {% if director_sig %}<img src=\"{{ director_sig }}\" class=\"signature-image\">{% endif %}\n                <div class=\"signature-line\"></div>\n                <div class=\"signature-name\">\n                    {{ director_name or \"Director\" }}\n                </div>\n            </div>\n\n        </div>\n\n    </div>\n\n</div>\n",
