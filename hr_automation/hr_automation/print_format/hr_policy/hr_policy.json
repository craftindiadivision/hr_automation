 "html": "\n<style>\n\t@page { size: A4; margin: 0; }\n\t.hr-policy-print { font-family: \"Segoe UI\", Arial, sans-serif; color: #1a1a1a; padding: 10mm 14mm; }\n\n\t.logo-wrapper { text-align: left; margin-bottom: 6mm; }\n\t.company-logo { height: 46px; }\n\n\t.policy-title {\n\t\ttext-align: center;\n\t\tfont-size: 22px;\n\t\tfont-weight: 700;\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 0.5px;\n\t\tmargin: 0 0 6mm 0;\n\t}\n\t.effective-date {\n\t\ttext-align: center;\n\t\tcolor: #555;\n\t\tfont-size: 12px;\n\t\tfont-style: italic;\n\t\tmargin-bottom: 8mm;\n\t}\n\n\t.policy-section { margin-bottom: 6mm; page-break-inside: avoid; }\n\t.section-heading {\n\t\tfont-size: 15px;\n\t\tfont-weight: 700;\n\t\tmargin-bottom: 3mm;\n\t}\n\t.section-body { font-size: 13px; line-height: 1.6; text-align: justify; }\n\t.section-body p { margin: 0 0 2mm 0; }\n</style>\n\n<div class=\"hr-policy-print\">\n\t<div class=\"logo-wrapper\">\n\t\t<img src=\"/files/craft_logo (1).png\" class=\"company-logo\">\n\t</div>\n\n\t<div class=\"policy-title\">{{ doc.policy_title }}</div>\n\n\t{% if doc.effective_date %}\n\t<div class=\"effective-date\">\n\t\tEffective from {{ frappe.utils.formatdate(doc.effective_date, \"dd MMMM, yyyy\") }}\n\t</div>\n\t{% endif %}\n\n\t{% for row in doc.sections %}\n\t<div class=\"policy-section\">\n\t\t<div class=\"section-heading\">{{ row.heading }}</div>\n\t\t<div class=\"section-body\">{{ row.explanation }}</div>\n\t</div>\n\t{% endfor %}\n</div>\n",
